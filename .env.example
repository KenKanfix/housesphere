# AI provider: "gemini" (Google AI Studio) or "openai".
AI_PROVIDER=gemini

# Google AI Studio key used by the /api/ai serverless function.
# Set this in Vercel -> Project -> Settings -> Environment Variables.
# For local development, copy this file to .env.local and fill it in.
GEMINI_API_KEY=AQ.your-key-here
GEMINI_MODEL=gemini-3.8-flash

# OpenAI alternative
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Absolute API URL for the Capacitor native builds. Leave unset for the web PWA.
VITE_API_BASE_URL=https://housesphere.vercel.app

# RevenueCat public SDK key (goog_… for Google Play, appl_… for the App Store).
# This is a public key, safe to embed in the native bundle.
VITE_REVENUECAT_API_KEY=goog_your-key-here
VITE_REVENUECAT_DEBUG=false

# Shared secret configured on the RevenueCat webhook.
REVENUECAT_WEBHOOK_SECRET=replace-me

# Upstash Redis REST credentials. Required for server-side quotas and the Pro
# entitlement written by the RevenueCat webhook.
UPSTASH_REDIS_REST_URL=https://your-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me

# Optional origins allowed to call /api/ai and /api/webhooks/revenuecat.
# ALLOWED_ORIGINS=https://housesphere.vercel.app,https://localhost,capacitor://localhost

# Daily action ceilings enforced on the server.
FREE_AI_DAILY_LIMIT=3
PRO_AI_DAILY_LIMIT=10
