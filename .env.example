# AI provider: "gemini" (Google AI Studio) or "openai".
AI_PROVIDER=gemini

# Google AI Studio key used by the /api/ai serverless function.
# Set this in Vercel -> Project -> Settings -> Environment Variables.
# For local development, copy this file to .env.local and fill it in.
GEMINI_API_KEY=AQ.your-key-here
GEMINI_MODEL=gemini-3.8-flash

# OpenAI alternative
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
