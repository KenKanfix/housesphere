# OpenAI key used by the /api/ai serverless function.
# Set this in Vercel → Project → Settings → Environment Variables.
# For local development, copy this file to .env.local and fill it in.
OPENAI_API_KEY=sk-your-key-here

# Optional model override (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Optional proxy/base URL (for OpenAI-compatible providers)
# OPENAI_BASE_URL=https://api.openai.com/v1
